/* Colours come from the active theme (tui/theme.py), so light and dark both work.
   Default theme: all-configs-light (ALL_CONFIGS_THEME=dark, or ctrl+p). */

/* one flat surface everywhere; panels are told apart by their borders */
Screen {
    background: $surface;
}

/* top bar: brand, breadcrumb, summary */

#topbar {
    height: 1;
    padding: 0 2;
}

#brand {
    width: auto;
    color: $primary;
    text-style: bold;
}

#crumb {
    width: auto;
    padding-left: 2;
    color: $text-muted;
}

#summary {
    width: 1fr;
    text-align: right;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* panels: thin rounded borders with titles, accent when focused */

#module-table, #jobs, #log, #empty {
    border: round $border-blurred;
    border-title-color: $text-muted;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
    background: $surface;
    scrollbar-size-vertical: 1;
}

#module-table:focus, #log:focus {
    border: round $primary;
    border-title-color: $primary;
}

/* main screen */

#search-row {
    height: 1;
    margin: 1 1 0 1;
    padding: 0 1;
    background: $foreground 4%;
}

#search-row:focus-within {
    background: $primary 10%;
}

#search-icon {
    width: 2;
    color: $text-muted;
    text-style: bold;
}

#search-row:focus-within #search-icon {
    color: $primary;
}

#search {
    width: 1fr;
    background: transparent;
}

#module-table {
    height: 1fr;
    margin: 1 1 0 1;
    overflow-x: hidden;
}

#module-table > .datatable--header {
    background: $surface;
    color: $text-muted;
    text-style: bold;
}

#module-table:focus > .datatable--header {
    background-tint: transparent;
}

#module-table:focus {
    background-tint: transparent;
}

#empty {
    height: 1fr;
    margin: 1 1 0 1;
    content-align: center middle;
    color: $text-muted;
}

#selection-bar {
    height: 1;
    margin: 0 2;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

Footer {
    background: $footer-background;
}

/* dialogs */

ConfirmScreen, HelpScreen {
    align: center middle;
    background: $background 70%;
}

#dialog {
    width: 60;
    max-width: 90%;
    height: auto;
    max-height: 85%;
    padding: 1 2 0 2;
    border: round $primary;
    border-title-color: $primary;
    border-title-style: bold;
    border-subtitle-color: $text-muted;
    background: $surface;
}

#dialog.danger {
    border: round $error;
    border-title-color: $error;
}

#dialog.help {
    width: 70;
}

#confirm-body {
    height: auto;
    max-height: 20;
    scrollbar-size-vertical: 1;
}

.buttons {
    height: 1;
    margin: 1 0;
    align-horizontal: right;
}

/* compact, flat buttons: neutral by default, solid for the main action */

Button {
    min-width: 10;
    margin-left: 2;
    padding: 0 1;
    color: $foreground;
    background: $foreground 8%;
}

Button:hover {
    background: $foreground 14%;
}

Button.-primary {
    color: $surface;
    background: $primary;
    text-style: bold;
}

Button.-error {
    color: $surface;
    background: $error;
    text-style: bold;
}

Button.-primary:hover, Button.-error:hover {
    background-tint: $surface 15%;
}

Button:focus {
    text-style: bold;
    background-tint: $foreground 18%;
}

Button:disabled {
    color: $foreground 35%;
    background: $foreground 5%;
    text-style: none;
}

/* run screen */

#run-body {
    height: 1fr;
    margin: 1 1 0 1;
}

#jobs {
    width: 28;
    height: 1fr;
}

#run-main {
    width: 1fr;
    margin-left: 1;
}

#log {
    height: 1fr;
    padding: 0 1;
    overflow-x: hidden;
}

#log.ok {
    border: round $success;
    border-subtitle-color: $success;
}

#log.err {
    border: round $error;
    border-subtitle-color: $error;
}

#log.warn {
    border: round $warning;
    border-subtitle-color: $warning;
}

#live {
    display: none;
    height: 1;
    padding: 0 2;
    color: $text-muted;
}

#reply {
    display: none;
    border: round $warning;
    border-title-color: $warning;
    border-title-style: bold;
    background: $surface;
}

#reply.waiting {
    display: block;
}

#reply:focus {
    border: round $warning;
    background-tint: transparent;
}

#run-bar {
    height: 1;
    margin: 1 1;
    padding: 0 1;
}

#progress {
    width: 1fr;
}

#progress Bar {
    width: 1fr;
}

#progress Bar > .bar--bar {
    color: $primary;
    background: $panel;
}

#progress Bar > .bar--complete {
    color: $success;
    background: $panel;
}

#progress PercentageStatus {
    color: $text-muted;
}
